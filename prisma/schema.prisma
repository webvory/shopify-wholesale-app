// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
model WholesaleRule {
  id            String   @id @default(cuid())
  shop          String
  name          String
  discountType  String   // percentage | fixed | override
  discountValue Float
  minQuantity   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model WholesaleDiscount {
  id        Int      @id @default(autoincrement())
  shop      String
  tag       String
  discount  Int
  createdAt DateTime @default(now())
}

model RegistrationPage {
  id                String   @id @default(cuid())
  shop              String
  name              String
  handle            String
  status            String   @default("draft")
  configuration     Json
  styling           Json
  settings          Json
  publishedSnapshot Json?
  publishedHandle   String?
  revision          Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  publishedAt       DateTime?
  applications      WholesaleApplication[]

  @@unique([shop, handle])
  @@unique([shop, publishedHandle])
  @@index([shop, updatedAt])
}

model WholesaleApplication {
  id                    String   @id @default(cuid())
  shop                  String
  registrationPageId    String?
  page                  RegistrationPage? @relation(fields: [registrationPageId], references: [id], onDelete: SetNull)
  pageName              String
  status                String   @default("pending")
  submittedData         Json
  configurationSnapshot Json
  settingsSnapshot      Json
  companyName           String   @default("")
  applicantName         String   @default("")
  email                 String   @default("")
  country               String   @default("")
  customerId            String?
  companyId             String?
  companyLocationId     String?
  companyContactId      String?
  adminNote             String   @default("")
  integrationError      String?
  integrationState      Json     @default("{}")
  processingAt          DateTime?
  version               Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  files                 ApplicationFile[]
  notifications         EmailNotification[]

  @@index([shop, status, createdAt])
  @@index([shop, email])
}

model ApplicationFile {
  id            String @id @default(cuid())
  shop          String
  applicationId String
  application   WholesaleApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fieldId       String
  filename      String
  mimeType      String
  size          Int
  data          Bytes

  @@index([shop, applicationId])
}

model SubmissionNonce {
  id        String @id
  shop      String
  pageId    String
  expiresAt DateTime

  @@index([shop, expiresAt])
}

model SubmissionRate {
  id          String @id
  shop        String
  windowStart DateTime
  count       Int @default(1)

  @@index([shop, windowStart])
}

model EmailNotification {
  id            String @id @default(cuid())
  shop          String
  applicationId String
  application   WholesaleApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  event         String
  recipient     String
  subject       String
  body          String
  status        String @default("pending")
  error         String?
  createdAt     DateTime @default(now())
  sentAt        DateTime?

  @@index([shop, applicationId])
}
